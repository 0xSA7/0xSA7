---
import '../styles/global.css';

const { frontmatter } = Astro.props;
const siteName = '0xSA7';
const pageUrl = Astro.url.href;
const description = frontmatter.description || 'Saleh Diaa Ahmed - Software Security Engineer';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter.title}   {siteName}</title>
  <meta name="description" content={description} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={`${frontmatter.title}   ${siteName}`} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:image" content="/0xSA7/favicon.svg" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${frontmatter.title}   ${siteName}`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="/0xSA7/favicon.svg" />

  <!-- Apply theme before paint -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      const osDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (osDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <link rel="icon" type="image/png" href="/0xSA7/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <main>

    <header class="site-header">
      <div>
        <a href="#" class="back-link" id="back-link">← back</a>
      </div>
      <button
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Toggle theme"
      >
        ☾
      </button>
    </header>

    <article class="blog-post">
      <h1>{frontmatter.title}</h1>
      <p class="blog-meta">
        <time>{frontmatter.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        {frontmatter.readTime && <span class="blog-readtime">{frontmatter.readTime}</span>}
        {frontmatter.tags && frontmatter.tags.map(t => <span class="blog-tag">{t}</span>)}
      </p>
      {frontmatter.pr && (
        <p class="blog-source">
          source: <a href={frontmatter.pr} target="_blank" rel="noopener noreferrer">PR on GitHub ↗</a>
        </p>
      )}
      {frontmatter.repo && (
        <p class="blog-source">
          source: <a href={frontmatter.repo} target="_blank" rel="noopener noreferrer">repo on GitHub ↗</a>
        </p>
      )}

      <div class="blog-content prose">
        <slot />
      </div>
    </article>

  </main>

  <script is:inline>
    (function() {
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const current = root.getAttribute('data-theme');
      toggle.textContent = current === 'dark' ? '☀' : '☾';

      toggle.addEventListener('click', () => {
        const now = root.getAttribute('data-theme');
        const next = now === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        toggle.textContent = next === 'dark' ? '☀' : '☾';
      });

      const backLink = document.getElementById('back-link');
      backLink.addEventListener('click', (e) => {
        e.preventDefault();
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/0xSA7/';
        }
      });
    })();
  </script>

  <script is:inline>
    (function() {
      // Wait for mermaid diagrams to render
      const setupMermaidZoom = () => {
        document.querySelectorAll('pre.mermaid, div.mermaid').forEach((el) => {
          const svg = el.querySelector('svg');
          if (!svg) return;

          // Strip inline max-width that mermaid.js sets
          svg.removeAttribute('style');
          svg.style.width = '100%';
          svg.style.maxWidth = '100%';
          svg.style.height = 'auto';

          // Skip if already wrapped
          if (el.parentElement && el.parentElement.classList.contains('mermaid-container')) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid-wrapper';

          const container = document.createElement('div');
          container.className = 'mermaid-container';

          const controls = document.createElement('div');
          controls.className = 'mermaid-controls';

          const zoomInBtn = document.createElement('button');
          zoomInBtn.className = 'mermaid-btn';
          zoomInBtn.textContent = '+';
          zoomInBtn.title = 'Zoom in';

          const zoomOutBtn = document.createElement('button');
          zoomOutBtn.className = 'mermaid-btn';
          zoomOutBtn.textContent = '-';
          zoomOutBtn.title = 'Zoom out';

          const resetBtn = document.createElement('button');
          resetBtn.className = 'mermaid-btn';
          resetBtn.textContent = 'R';
          resetBtn.title = 'Reset zoom';

          controls.appendChild(zoomInBtn);
          controls.appendChild(zoomOutBtn);
          controls.appendChild(resetBtn);

          el.parentNode.insertBefore(wrapper, el);
          wrapper.appendChild(container);
          wrapper.appendChild(controls);
          container.appendChild(el);

          let scale = 1;
          let panX = 0;
          let panY = 0;
          let isDragging = false;
          let startX = 0;
          let startY = 0;
          let startPanX = 0;
          let startPanY = 0;

          const applyTransform = () => {
            svg.style.transformOrigin = '0 0';
            svg.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + scale + ')';
          };

          const zoom = (delta) => {
            scale = Math.max(0.3, Math.min(3, scale + delta));
            applyTransform();
          };

          zoomInBtn.addEventListener('click', () => zoom(0.2));
          zoomOutBtn.addEventListener('click', () => zoom(-0.2));
          resetBtn.addEventListener('click', () => {
            scale = 1; panX = 0; panY = 0;
            applyTransform();
          });

          container.addEventListener('wheel', (e) => {
            e.preventDefault();
            zoom(e.deltaY < 0 ? 0.1 : -0.1);
          }, { passive: false });

          container.addEventListener('mousedown', (e) => {
            isDragging = true;
            startX = e.clientX;
            startY = e.clientY;
            startPanX = panX;
            startPanY = panY;
          });

          document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            panX = startPanX + (e.clientX - startX);
            panY = startPanY + (e.clientY - startY);
            applyTransform();
          });

          document.addEventListener('mouseup', () => { isDragging = false; });

          // Touch support
          let touchStartX = 0, touchStartY = 0;
          let touchStartPanX = 0, touchStartPanY = 0;
          let touchStartDist = 0, touchStartScale = 1;

          container.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
              touchStartX = e.touches[0].clientX;
              touchStartY = e.touches[0].clientY;
              touchStartPanX = panX;
              touchStartPanY = panY;
            } else if (e.touches.length === 2) {
              const dx = e.touches[0].clientX - e.touches[1].clientX;
              const dy = e.touches[0].clientY - e.touches[1].clientY;
              touchStartDist = Math.sqrt(dx * dx + dy * dy);
              touchStartScale = scale;
            }
          }, { passive: true });

          container.addEventListener('touchmove', (e) => {
            if (e.touches.length === 1) {
              e.preventDefault();
              panX = touchStartPanX + (e.touches[0].clientX - touchStartX);
              panY = touchStartPanY + (e.touches[0].clientY - touchStartY);
              applyTransform();
            } else if (e.touches.length === 2) {
              e.preventDefault();
              const dx = e.touches[0].clientX - e.touches[1].clientX;
              const dy = e.touches[0].clientY - e.touches[1].clientY;
              const dist = Math.sqrt(dx * dx + dy * dy);
              scale = Math.max(0.3, Math.min(3, touchStartScale * (dist / touchStartDist)));
              applyTransform();
            }
          }, { passive: false });
        });
      };

      if (document.readyState === 'complete') {
        setTimeout(setupMermaidZoom, 500);
      } else {
        window.addEventListener('load', () => setTimeout(setupMermaidZoom, 500));
      }
    })();
  </script>
</body>
</html>
