---
import '../styles/global.css';

const { frontmatter } = Astro.props;
const siteName = '0xSA7';
const pageUrl = Astro.url.href;
const description = frontmatter.description || 'Saleh Diaa Ahmed - Software Security Engineer';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter.title} — {siteName}</title>
  <meta name="description" content={description} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={`${frontmatter.title} — ${siteName}`} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:image" content="/0xSA7/favicon.svg" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${frontmatter.title} — ${siteName}`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="/0xSA7/favicon.svg" />

  <!-- Apply theme before paint -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      const osDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (osDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <link rel="icon" type="image/png" href="/0xSA7/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <main>

    <header class="site-header">
      <div>
        <a href="#" class="back-link" id="back-link">← back</a>
      </div>
      <button
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Toggle theme"
      >
        ☾
      </button>
    </header>

    <article class="blog-post">
      <h1>{frontmatter.title}</h1>
      <p class="blog-meta">
        <time>{frontmatter.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        {frontmatter.readTime && <span class="blog-readtime">{frontmatter.readTime}</span>}
        {frontmatter.tags && frontmatter.tags.map(t => <span class="blog-tag">{t}</span>)}
      </p>
      {frontmatter.pr && (
        <p class="blog-source">
          source: <a href={frontmatter.pr} target="_blank" rel="noopener noreferrer">PR on GitHub ↗</a>
        </p>
      )}
      {frontmatter.repo && (
        <p class="blog-source">
          source: <a href={frontmatter.repo} target="_blank" rel="noopener noreferrer">repo on GitHub ↗</a>
        </p>
      )}

      <div class="blog-content prose">
        <slot />
      </div>
    </article>

  </main>

  <script is:inline>
    (function() {
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const current = root.getAttribute('data-theme');
      toggle.textContent = current === 'dark' ? '☀' : '☾';

      toggle.addEventListener('click', () => {
        const now = root.getAttribute('data-theme');
        const next = now === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        toggle.textContent = next === 'dark' ? '☀' : '☾';
      });

      const backLink = document.getElementById('back-link');
      backLink.addEventListener('click', (e) => {
        e.preventDefault();
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/0xSA7/';
        }
      });
    })();
  </script>
</body>
</html>
