          <div class="project-tech">
            <span>Proxmox</span><span>FortiGate</span><span>WireGuard</span><span>n8n</span>
          </div>
          <div class="project-highlights">
            <div class="ph-item">Fetch latest CVEs daily from NVD and CVE.org.</div>
            <div class="ph-item">Cross-check against public bug bounty programs.</div>
          </div>
        </div>

        <!-- HardLock -->
        <div class="project-card reveal" data-index="03">
          <div class="project-glow purple"></div>
          <div class="project-header">
            <div class="project-icon purple">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z"/></svg>
