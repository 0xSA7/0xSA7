---
import '../styles/global.css';

const projects = [
  {
    name: 'WatchZork',
    meta: 'KMDF kernel monitoring',
    github: 'https://github.com/WatchZork',
    blog: null,
  },
  {
  name: 'multipass: VM resource minima',
  meta: '#5057',
  url: 'https://github.com/canonical/multipass/pull/5057',
  blog: '/0xSA7/blog/multipass-vm-minima/',
  },
  {
    name: 'nixpkgs: Coulomb wrapper + co-maintainer',
    meta: '#526664',
    url: 'https://github.com/NixOS/nixpkgs/pull/526664',
    blog: '/0xSA7/blog/nixpkgs-coulomb-wrapper/',
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0xSA7 @ Saleh Diaa Ahmed</title>
  <meta name="description" content="Saleh Diaa Ahmed - Software Security Engineer. Open source contributor, kernel engineer, NixOS user." />
  <meta name="author" content="Saleh Diaa Ahmed" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://0xsa7.github.io/0xSA7/" />
  <meta property="og:title" content="0xSA7 @ Saleh Diaa Ahmed" />
  <meta property="og:description" content="Software Security Engineer. Open source contributor, kernel engineer, NixOS user." />
  <meta property="og:site_name" content="0xSA7" />
  <meta property="og:image" content="/0xSA7/favicon.svg" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="0xSA7 @ Saleh Diaa Ahmed" />
  <meta name="twitter:description" content="Software Security Engineer. Open source contributor, kernel engineer, NixOS user." />
  <meta name="twitter:image" content="/0xSA7/favicon.svg" />

  <!-- Apply theme before paint -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      const osDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (osDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <link rel="icon" type="image/png" href="/0xSA7/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <main>

    <header class="site-header">
      <div>
        <h1>Saleh Diaa Ahmed<span class="handle">[0xSA7]</span></h1>
        <p class="role">Software Security Engineer | Open-Source Contributor</p>
      </div>
      <button
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Toggle theme"
      >
        ☾
      </button>
    </header>

    <section class="block">
      <h2 class="block-title">whoami</h2>
      <p>
        Software Security Engineer working on kernel-level monitoring,
        digital forensics, and hardware root-of-trust. Currently finishing
        a B.Sc. in Systems &amp; Computer Engineering at Al-Azhar University.
      </p>
      <p>
        Open source contributor to NixOS / nixpkgs and Canonical Multipass.
        Founder of AZCTF.
      </p>
    </section>

    <section class="block">
      <h2 class="block-title">selected work</h2>
      <ul class="list">
        {projects.map(p => {
          const href = p.blog ?? p.github ?? '#';
          const target = href.startsWith('http') ? '_blank' : '_self';
          const rel = target === '_blank' ? 'noopener noreferrer' : undefined;
          return (
            <li>
              <a href={href} target={target} rel={rel}>
                <span>{p.name}</span>
                <span class="meta">{p.meta}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="block">
      <h2 class="block-title">writing</h2>
      <ul class="list">
        <li>
          <a href="/0xSA7/blog/">
            <span>blog index</span>
            <span class="meta">→</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="block">
      <h2 class="block-title">contact</h2>
      <ul class="list">
        <li>
          <a href="mailto:salehdiaaahmed@gmail.com">
            <span>email</span>
            <span class="meta">salehdiaaahmed@gmail.com</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/0xSA7">
            <span>github</span>
            <span class="meta">@0xSA7</span>
          </a>
        </li>
        <li>
          <a href="https://linkedin.com/in/salehdiaaahmed">
            <span>linkedin</span>
            <span class="meta">/salehdiaaahmed</span>
          </a>
        </li>
      </ul>
    </section>

    <footer class="site-footer">
      <span>0xSA7</span>
      <span class="footer-meta">built with astro</span>
    </footer>

  </main>

  <script is:inline>
    (function() {
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');

      // Sync icon with the actual current theme (set in <head>)
      const current = root.getAttribute('data-theme');
      toggle.textContent = current === 'dark' ? '☀' : '☾';

      toggle.addEventListener('click', () => {
        const now = root.getAttribute('data-theme');
        const next = now === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        toggle.textContent = next === 'dark' ? '☀' : '☾';
      });
    })();
  </script>
</body>
</html>